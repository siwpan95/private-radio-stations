{
  "manifest_version": 3,
  "name": "PyRadio Companion",
  "version": "1.0.0",
  "description": "纯 Python 电台的浏览器伴侣：弹窗看正在播放 + 同步歌词 + 远程控制，并可一键发布到 Discord/Telegram。Edge 与 Chrome 共用同一套（Chromium MV3 完全一致）。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PyRadio 正在播放"
  },
  "options_page": "options.html",
  "icons": {
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://lrclib.net/*",
    "https://api.telegram.org/*",
    "https://discord.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
