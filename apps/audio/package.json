{
  "name": "@relay/radio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Relay-only internet radio station (Node.js + Cordis). Proxies remote audio streams with ffmpeg transcode, multi-bitrate mounts, HLS output, global station browse, and a control panel.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "check": "node scripts/check.mjs",
    "test": "node --test test/station.test.mjs test/presets.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev:web": "vite",
    "build:web": "vite build"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.8",
    "js-yaml": "^4.1.0",
    "@relay/core": "*",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
