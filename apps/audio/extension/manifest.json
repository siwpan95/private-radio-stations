{
  "manifest_version": 3,
  "name": "转播电台 (Private Radio Relay)",
  "version": "3.0.0",
  "description": "Node.js + Cordis 转播电台的浏览器伴侣：弹窗看转播状态 + 一键转播 / 停止 / 收藏（支持多源 failover），Edge 与 Chrome 共用（Chromium MV3）。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "转播电台"
  },
  "options_page": "options.html",
  "icons": {
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
