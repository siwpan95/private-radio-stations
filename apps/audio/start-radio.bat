@echo off
REM Private Radio Stations - Node.js launcher (generated by gen_start_bat.py)
setlocal
cd /d "%~dp0"
set NODE_OPTIONS=
set PORT=8000
set PROXY_PORT=8899
set NPM_PROXY_PORT=%PROXY_PORT%

REM --- resolve python: never hardcode a drive letter (repo moved G: -> D: -> C:) ---
REM order: PYTHON env var > python on PATH > py -3 > run without the mirror proxy
set "PYEXE="
if defined PYTHON set "PYEXE=%PYTHON%"
if not defined PYEXE (
  where python >nul 2>nul
  if not errorlevel 1 set "PYEXE=python"
)
if not defined PYEXE (
  where py >nul 2>nul
  if not errorlevel 1 set "PYEXE=py -3"
)

REM --- start local npm mirror proxy if not already listening ---
curl -s -o nul -m 2 http://127.0.0.1:%PROXY_PORT%/ >nul 2>&1
if not errorlevel 1 goto waitproxy
if not defined PYEXE goto proxyskip
start "" /b %PYEXE% npm_local_mirror.py
goto waitproxy
:proxyskip
echo [start-radio] python not found; starting without local mirror proxy
echo [start-radio] (set PYTHON=^<full path to python.exe^> to enable it)

REM --- wait for proxy (max 30s) ---
set /a n=0
:waitproxy
curl -s -o nul -m 2 http://127.0.0.1:%PROXY_PORT%/ >nul 2>&1
if not errorlevel 1 goto proxyok
set /a n+=1
if %n%==30 goto proxyfail
timeout /t 1 >nul
goto waitproxy
:proxyok

REM --- install deps through proxy if missing ---
if not exist node_modules (
  echo [start-radio] installing dependencies via mirror proxy...
  npm install --no-audit --no-fund --registry=http://127.0.0.1:%PROXY_PORT%
)

echo [start-radio] starting relay radio on http://localhost:8000
node src/index.js
goto end

:proxyfail
echo [start-radio] mirror proxy unavailable; installing without proxy
if not exist node_modules ( npm install --no-audit --no-fund )
node src/index.js

:end
endlocal
